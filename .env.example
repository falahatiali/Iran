DB_DRIVER=sqlite
DATABASE_URL=file:./data/iran.db
# Public origin for canonical, og:url, sitemap, robots. Production builds refuse a
# missing value or the old placeholder https://iran-history.example.
VITE_SITE_URL=http://localhost:3000
PORT=3000

# --- Comments (all optional in development) ---
# Separate SQLite file for readers' accounts and comments. Default: comments.db next to DATABASE_URL.
# COMMENTS_DATABASE_URL=file:./data/comments.db
# Who may moderate (comma-separated). They sign in with the same email code at /admin/comments.
ADMIN_EMAILS=you@example.com
# Development prints sign-in codes to the server console.
MAIL_TRANSPORT=console
