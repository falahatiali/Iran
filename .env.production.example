# Production Environment Configuration for Iran History
# Copy this to /home/deploy/envFiles/.env.iran-history on the server
# Set appropriate values and secure it with: chmod 600 /home/deploy/envFiles/.env.iran-history

# Node environment
NODE_ENV=production

# Application port (internal, not published)
PORT=3000

# Database configuration
DB_DRIVER=sqlite
DATABASE_URL=file:/data/iran.db

# Public origin. Canonical, og:url, sitemap, and robots are baked into the
# image at Docker build from GitHub PRODUCTION_URL / VITE_SITE_URL / APP_DOMAIN.
# Changing only this runtime file does not rewrite prerendered HTML; rebuild.
VITE_SITE_URL=https://iiraan.com

# Optional: Resource limits
NODE_OPTIONS=--max-old-space-size=512

# Optional: Logging level
# LOG_LEVEL=info
