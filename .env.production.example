# Production Environment Configuration for Iran History
# Copy this to /home/deploy/envFiles/.env.iran-history on the server
# Set appropriate values and secure it with: chmod 600 /home/deploy/envFiles/.env.iran-history

# Node environment
NODE_ENV=production

# Application port (internal, not published)
PORT=3000

# Database configuration
DB_DRIVER=sqlite
DATABASE_URL=file:/data/iran.db

# Public origin. Canonical, og:url, sitemap, and robots are baked into the
# image at Docker build from GitHub PRODUCTION_URL / VITE_SITE_URL / APP_DOMAIN.
# Changing only this runtime file does not rewrite prerendered HTML; rebuild.
VITE_SITE_URL=https://iiraan.com

# --- Comments ---
# Readers' accounts and comments live in their own SQLite file on the same /data volume
# (default when unset: /data/comments.db, next to DATABASE_URL). Never reset or reseeded.
# COMMENTS_DATABASE_URL=file:/data/comments.db
# Storage adapter for comments (see docs/COMMENTS.md, "Storage adapters"). Default: sqlite.
# COMMENTS_DB_DRIVER=sqlite

# Moderators: comma-separated emails. They sign in at /admin/comments with an emailed code.
ADMIN_EMAILS=admin@example.com

# Pepper for code hashes and IP hashes (32+ random characters, e.g. `openssl rand -base64 48`).
# Optional: when unset, one is generated once and kept inside comments.db.
# AUTH_SECRET=

# Mail for one-time sign-in codes. Without a transport, sign-in is disabled in production
# (codes are never written to logs). Pick ONE:
MAIL_FROM="تاریخ ایران <no-reply@iiraan.com>"
# a) SMTP (any provider: Brevo, Zoho, Amazon SES SMTP, Gmail app password, own server)
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# b) Resend HTTP API
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=

# Reverse proxies in front of the app whose X-Forwarded-For entry is trusted (Traefik = 1).
# TRUST_PROXY_HOPS=1

# Optional: Resource limits
NODE_OPTIONS=--max-old-space-size=512

# Optional: Logging level
# LOG_LEVEL=info
