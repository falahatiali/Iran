# Caddyfile configuration for Iran History
# Place this in /etc/caddy/Caddyfile or include it from main Caddyfile
# Then: sudo systemctl reload caddy

iran.example.com {
    # Automatic HTTPS with Let's Encrypt
    # Caddy handles certificate management automatically

    # Reverse proxy to application
    reverse_proxy localhost:3000 {
        # Health check
        health_uri /
        health_interval 30s
        health_timeout 5s
        
        # Load balancing (if you scale horizontally)
        # lb_policy round_robin
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/iran-history.log
        format json
    }

    # Error handling
    handle_errors {
        respond "An error occurred: {err.status_code} {err.status_text}"
    }
}
